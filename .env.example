# Gourmand — environment variables (names only; never commit values).
#
# Local development:
#   1. `npm run db:start`  starts local Supabase (Docker) and writes the
#      local Supabase URL/keys plus generated local secrets to
#      .env.development.local (local-only demo values, gitignored).
#   2. Put YOUR OWN keys for Stripe (test mode) and Resend in .env.local.
#      Never paste them into chat, issues or commits.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
# "true" only on the launched production site. Anything else = noindex.
NEXT_PUBLIC_SITE_INDEXABLE=

# --- Supabase (written by `npm run db:start` for local dev) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Stripe (TEST MODE ONLY locally: rk_test_… preferred, or sk_test_…) ------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# --- Resend --------------------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend (orders@gourmand.bg at launch).
EMAIL_FROM=
# Used when the owner hasn't set a notification address in the admin.
OWNER_NOTIFICATION_EMAIL=

# --- Server secrets (generated locally by `npm run db:start`) -----------------
# Bearer token for /api/cron (Vercel Cron sends it automatically in production).
CRON_SECRET=
# HMAC key for hashing IPs and phone numbers in rate-limit buckets.
RATE_LIMIT_SALT=
# Signs the private order-status links. Rotating it invalidates old links.
STATUS_LINK_SECRET=

# --- Cloudflare Turnstile (wired up, switched off in the admin by default) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local testing only --------------------------------------------------------
# "1" lets Playwright fix the server clock via a cookie. Ignored in production.
ALLOW_TEST_CLOCK=
# Local owner account created by `npm run db:owner` (test credentials, local only).
DEV_OWNER_EMAIL=
DEV_OWNER_PASSWORD=
