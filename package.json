{
  "name": "gourmand-plovdiv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start && node scripts/local-env.mjs && node scripts/create-owner.mjs",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/build-seed.mjs && supabase db reset && node scripts/create-owner.mjs",
    "db:env": "node scripts/local-env.mjs",
    "db:owner": "node scripts/create-owner.mjs",
    "seed:build": "node scripts/build-seed.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "cron": "node scripts/dev-cron.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:fixture": "node scripts/dev-fixture.mjs",
    "test:db": "vitest run --project db",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.115.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.53.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
